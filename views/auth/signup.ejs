<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PADAM - Sign Up</title>

  <!-- Fonts + Tailwind -->
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap"
    rel="stylesheet"
  />
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    body {
      font-family: "Poppins", sans-serif;
    }
    .lotus-logo {
      filter: drop-shadow(0 4px 6px rgba(116, 105, 79, 0.6));
    }
    .golden-border {
      border: 6px solid transparent;
      border-image: linear-gradient(135deg, #d3a673, #facc15, #a77d63);
      border-image-slice: 1;
    }
  </style>
</head>

<body
  class="bg-gradient-to-br from-amber-100 via-yellow-50 to-amber-200 min-h-screen flex items-center justify-center p-4"
>
  <!-- Back Button -->
  <a
    href="/"
    class="absolute top-4 left-4 z-10 p-3 bg-white/70 rounded-full shadow-md text-amber-700 hover:bg-white transition-all duration-200"
  >
    <svg
      class="w-6 h-6"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M10 19l-7-7m0 0l7-7m-7 7h18"
      ></path>
    </svg>
  </a>

  <!-- Main Container -->
  <div
    class="bg-white/90 backdrop-blur-lg rounded-3xl shadow-2xl overflow-hidden max-w-6xl w-full flex flex-col md:flex-row border-4 border-amber-200"
  >
    <!-- Left Side Image -->
    <div
      class="md:w-1/2 bg-gradient-to-br from-amber-50 to-yellow-100 flex items-center justify-center p-4"
    >
      <div
        class="w-full h-full golden-border rounded-2xl overflow-hidden shadow-xl"
      >
        <div
          class="w-full h-full bg-center bg-no-repeat bg-contain"
          style="background-image: url('../../images/signup.png');"
        ></div>
      </div>
    </div>

    <!-- Right Side -->
    <div
      class="md:w-1/2 p-10 md:p-14 flex flex-col justify-center items-center bg-gradient-to-br from-white to-amber-50"
    >
      <div class="w-full max-w-sm">
        <!-- Logo -->
        <div class="flex flex-col items-center justify-center mb-10">
          <svg
            class="w-14 h-14 text-amber-600 lotus-logo"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 21s-8-8-8-12c0-4.418 3.582-8 8-8s8 3.582 8 8c0 4-8 12-8 12z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 21s4-4 4-8-4-8-4-8-4 4-4 8 4 8 4 8z"
            ></path>
          </svg>

          <h1 class="text-4xl font-bold text-amber-800 mt-3 tracking-wide">
            PADAM TRADERS
          </h1>
          <p class="text-sm text-gray-600 font-light mt-1">
            Purity in Every Drop
          </p>
        </div>

        <h2 class="text-2xl font-semibold text-center text-gray-800 mb-6">
          Create Account
        </h2>

        <!-- ✅ Signup Form -->
        <form id="signupForm" action="/register" method="post" class="space-y-6">
          <!-- Email -->
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Email"
            required
            class="w-full px-6 py-4 border-2 border-amber-300 rounded-xl bg-white/70"
          />

          <!-- ✅ Send OTP Button -->
          <button
            type="button"
            id="sendOtpBtn"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-4 rounded-xl transition-all duration-300 shadow-lg"
          >
            Send OTP
          </button>

          <!-- ✅ OTP Box -->
          <div id="otpBox" class="hidden space-y-4">
            <input
              type="text"
              id="otp"
              placeholder="Enter 6-digit OTP"
              class="w-full px-6 py-4 border-2 border-amber-300 rounded-xl bg-white/70"
            />

            <button
              type="button"
              id="verifyOtpBtn"
              class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-4 rounded-xl shadow-lg"
            >
              Verify OTP
            </button>

            <!-- ✅ Resend OTP -->
            <button
              type="button"
              id="resendOtpBtn"
              class="w-full bg-gray-600 hover:bg-gray-700 text-white font-semibold py-3 rounded-xl shadow-md"
              disabled
            >
              Resend OTP
            </button>

            <p id="timerText" class="text-center text-sm text-gray-500"></p>
          </div>

          <!-- ✅ Final Fields -->
          <div id="finalFields" class="hidden space-y-6">
            <input
              type="text"
              name="username"
              placeholder="Username"
              required
              class="w-full px-6 py-4 border-2 border-amber-300 rounded-xl bg-white/70"
            />

            <input
              type="password"
              name="password"
              placeholder="Password"
              required
              class="w-full px-6 py-4 border-2 border-amber-300 rounded-xl bg-white/70"
            />

            <!-- Seller Checkbox -->
            <div class="flex items-center space-x-2">
              <input
                type="checkbox"
                id="applySeller"
                name="applySeller"
                value="true"
                class="w-4 h-4 text-amber-600"
              />
              <label for="applySeller" class="text-gray-700">
                Apply to become a Seller
              </label>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="w-full bg-gradient-to-br from-amber-600 to-amber-800 hover:from-amber-700 hover:to-amber-900 text-white font-semibold py-4 rounded-xl shadow-lg"
            >
              Create Account
            </button>
          </div>
        </form>

        <!-- Divider -->
        <div class="flex items-center my-6">
          <hr class="flex-grow border-gray-300" />
          <span class="px-4 text-sm text-gray-500 font-medium">OR</span>
          <hr class="flex-grow border-gray-300" />
        </div>

        <!-- Google Signup -->
        <a
          href="/auth/google"
          class="w-full block text-center bg-white border-2 border-gray-300 hover:border-gray-400 text-gray-700 font-semibold py-4 px-6 rounded-xl transition-all duration-300 transform hover:scale-105 shadow-lg"
        >
          <div class="flex justify-center items-center gap-3">
            <img
              src="https://www.svgrepo.com/show/475656/google-color.svg"
              alt="Google"
              class="w-6 h-6"
            />
            <span>Sign up with Google</span>
          </div>
        </a>

        <!-- Login Redirect -->
        <div class="mt-8 text-center text-gray-700">
          <p>
            Already have an account?
            <a
              href="/login"
              class="text-amber-700 hover:text-amber-900 font-semibold"
            >
              Log In
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ OTP Script -->
  <script>
    const sendOtpBtn = document.getElementById("sendOtpBtn");
    const verifyOtpBtn = document.getElementById("verifyOtpBtn");
    const resendOtpBtn = document.getElementById("resendOtpBtn");

    const otpBox = document.getElementById("otpBox");
    const finalFields = document.getElementById("finalFields");
    const timerText = document.getElementById("timerText");

    let countdown;

    // ✅ Timer for Resend OTP
    function startResendTimer() {
      let timeLeft = 30;
      resendOtpBtn.disabled = true;

      countdown = setInterval(() => {
        timerText.innerText = `Resend OTP available in ${timeLeft}s`;
        timeLeft--;

        if (timeLeft < 0) {
          clearInterval(countdown);
          resendOtpBtn.disabled = false;
          timerText.innerText = "";
        }
      }, 1000);
    }

    // ✅ SEND OTP
    sendOtpBtn.addEventListener("click", async () => {
      const email = document.getElementById("email").value;

      if (!email) {
        alert("Please enter email first!");
        return;
      }

      const res = await fetch("/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });

      const data = await res.json();

      if (data.error) {
        alert(data.error);
        return;
      }

      alert(data.message);

      otpBox.classList.remove("hidden");
      startResendTimer();
    });

    // ✅ VERIFY OTP
    verifyOtpBtn.addEventListener("click", async () => {
      const otp = document.getElementById("otp").value;

      const res = await fetch("/verify-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ otp }),
      });

      const data = await res.json();

      if (data.error) {
        alert(data.error);
        return;
      }

      alert("OTP Verified Successfully ✅");

      finalFields.classList.remove("hidden");
      otpBox.classList.add("hidden");
      sendOtpBtn.disabled = true;
    });

    // ✅ RESEND OTP
    resendOtpBtn.addEventListener("click", async () => {
      const res = await fetch("/resend-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
      });

      const data = await res.json();

      if (data.error) {
        alert(data.error);
        return;
      }

      alert(data.message);
      startResendTimer();
    });
  </script>
</body>
</html>
